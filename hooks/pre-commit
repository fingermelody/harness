#!/bin/bash
# WebHarness Pre-commit Hook
# 在提交前执行代码检查

set -e

echo "🪝 Running pre-commit checks..."

# 获取 staged 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files to check"
    exit 0
fi

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 统计
CHECKS_PASSED=0
CHECKS_FAILED=0

# 1. 敏感信息检查
echo ""
echo "🔍 Checking for sensitive information..."
SENSITIVE_PATTERNS="(password|secret|api_key|token|private_key)\s*=\s*['\"][^'\"]{5,}['\"]"
SENSITIVE_FOUND=false

for file in $STAGED_FILES; do
    if [ -f "$file" ] && [[ "$file" != *"node_modules"* ]]; then
        if grep -E "$SENSITIVE_PATTERNS" "$file" 2>/dev/null; then
            echo -e "  ${RED}⚠️  $file may contain sensitive data${NC}"
            SENSITIVE_FOUND=true
            ((CHECKS_FAILED++))
        fi
    fi
done

if [ "$SENSITIVE_FOUND" = false ]; then
    echo -e "  ${GREEN}✅ No sensitive data detected${NC}"
    ((CHECKS_PASSED++))
fi

# 2. TypeScript 检查
TS_FILES=$(echo "$STAGED_FILES" | grep -E "\.ts$|\.tsx$" || true)
if [ -n "$TS_FILES" ]; then
    echo ""
    echo "🔍 Running TypeScript check..."
    if npx tsc --noEmit 2>/dev/null; then
        echo -e "  ${GREEN}✅ TypeScript check passed${NC}"
        ((CHECKS_PASSED++))
    else
        echo -e "  ${RED}❌ TypeScript check failed${NC}"
        ((CHECKS_FAILED++))
    fi
fi

# 3. ESLint 检查
JS_FILES=$(echo "$STAGED_FILES" | grep -E "\.ts$|\.tsx$|\.js$|\.jsx$" || true)
if [ -n "$JS_FILES" ] && [ -f ".eslintrc.json" ]; then
    echo ""
    echo "🔍 Running ESLint..."
    if npx eslint $JS_FILES 2>/dev/null; then
        echo -e "  ${GREEN}✅ ESLint passed${NC}"
        ((CHECKS_PASSED++))
    else
        echo -e "  ${YELLOW}⚠️  ESLint warnings (non-blocking)${NC}"
    fi
fi

# 4. 测试检查
if [ -f "vitest.config.ts" ] || [ -f "jest.config.js" ]; then
    echo ""
    echo "🔍 Running unit tests for changed files..."
    # 简单检查：是否包含测试文件
    TEST_FILES=$(echo "$STAGED_FILES" | grep -E "\.(test|spec)\.(ts|tsx|js|jsx)$" || true)
    if [ -n "$TEST_FILES" ]; then
        if npm test -- --run 2>/dev/null; then
            echo -e "  ${GREEN}✅ Tests passed${NC}"
            ((CHECKS_PASSED++))
        else
            echo -e "  ${RED}❌ Tests failed${NC}"
            ((CHECKS_FAILED++))
        fi
    fi
fi

# 总结
echo ""
echo "========================"
echo -e "Pre-commit: ${GREEN}$CHECKS_PASSED passed${NC}, ${RED}$CHECKS_FAILED failed${NC}"

if [ $CHECKS_FAILED -gt 0 ]; then
    echo ""
    echo -e "${RED}❌ Pre-commit check failed. Please fix errors before committing.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ All checks passed!${NC}"
exit 0